# Download output: keep the folder, ignore generated media and temp files
downloads/*
!downloads/.gitkeep
*.part

# Portable Node.js runtime downloaded by the launchers
.runtime/
node_modules/
.npm-cache/

# Local logs and temporary files
*.log
*.tmp

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Local environment files
.env
.env.*
!.env.example
